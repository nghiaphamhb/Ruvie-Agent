# Copy this file to .env and replace the placeholder with a local password.
DATABASE_URL=postgresql+psycopg://ruvie:replace-with-local-password@localhost:5432/ruvie
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure chat and embedding URL/key independently in System settings > AI connections.
# Embedding profile is pinned server-side to baai/bge-m3 / 1024 / cosine.
# Legacy EMBEDDING_BASE_URL / EMBEDDING_API_KEY are ignored at runtime.
# F018: admin controls embedding Direct/SOCKS5 network route in PostgreSQL.
# Preserve the previous EMBEDDING_PROXY_URL only for the one-time operator CLI.
# Runtime ignores it; do not add it to new process environments.

# Shared Fernet encryption key for the independent chat and embedding credentials.
# Backend and worker must use the same key; preserve it with database backups.
LLM_SETTINGS_ENCRYPTION_KEY=

# Exact origins for HTTP/private providers; omit /v1. Empty denies those endpoints.
# Example: http://localhost:11434,http://127.0.0.1:11434
# localhost is the backend machine. The UI cannot change this allowlist.
LLM_ALLOWED_LOCAL_ORIGINS=

# F018: admin controls reply-model Direct/SOCKS5 route in PostgreSQL.
# Preserve the previous LLM_PROXY_URL only for the one-time operator CLI.
# Runtime ignores it. Proxy credentials and HTTP/HTTPS are not supported.
