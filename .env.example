# Copy this file to .env and replace the placeholder with a local password.
DATABASE_URL=postgresql+psycopg://ruvie:replace-with-local-password@localhost:5432/ruvie
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMBEDDING_MODEL_ID=baai/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_BASE_URL=https://embedding.example.com/v1
EMBEDDING_API_KEY=replace-with-local-embedding-api-key

# Optional server fallback. Leave empty to configure a personal connection in the UI.
# Example Base URL: https://provider.example.com/v1
LLM_BASE_URL=
# Optional model ID; an available default or the first model is used before selection.
LLM_MODEL=
# Required only by providers that need a key. Keep real keys local.
LLM_API_KEY=
# Exact origins for HTTP/private providers; omit /v1. Empty denies those endpoints.
# Example: http://localhost:11434,http://127.0.0.1:11434
# localhost is the backend machine. The UI cannot change this allowlist.
LLM_ALLOWED_LOCAL_ORIGINS=

# Optional server-owned SOCKS5 egress for model discovery and chat. Empty means direct.
# Example Hiddify mixed port: socks5://127.0.0.1:12334 (backend machine).
# HTTP/HTTPS proxy URLs and proxy credentials are not supported.
LLM_PROXY_URL=
